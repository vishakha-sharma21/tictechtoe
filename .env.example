# ── Database ─────────────────────────────────────────────
# Local mongod works out of the box. For Atlas, paste your mongodb+srv:// URI here AND in mcp_agent/.env
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=nexflow

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=CHANGE_ME
NEXTAUTH_URL=http://localhost:3000

# ── Secrets shared with mcp_agent/.env (must be IDENTICAL in both files) ──
ENCRYPTION_KEY=CHANGE_ME
BACKEND_JWT_SECRET=CHANGE_ME

# ── Python backend ───────────────────────────────────────
MCP_AGENT_URL=http://localhost:8010
NEXT_PUBLIC_MCP_AGENT_URL=http://localhost:8010

# ── Google (login = identity only; Gmail/Drive are a separate "connector") ──
# Authorized redirect URIs to register in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# ── GitHub connector ─────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/oauth/github/callback

# ── Discord connector ────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/oauth/discord/callback
