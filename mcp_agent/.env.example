# Inside Docker, 127.0.0.1 is the container itself. Use host.docker.internal for a Mongo on your Mac, or paste your Atlas URI.
MONGODB_URI=mongodb://host.docker.internal:27017
MONGODB_DB=nexflow
APP_URL=http://localhost:3000

# IDENTICAL to the values in ../.env.local
ENCRYPTION_KEY=CHANGE_ME
BACKEND_JWT_SECRET=CHANGE_ME

# NOTE: no OPENAI_API_KEY here on purpose — users bring their own key (stored encrypted in the DB).

# Used by google_mcp for token refresh
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# twilio_mcp (platform-level, optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: override hosted open-model names (they change over time)
# GROQ_MODEL_SMART=llama-3.3-70b-versatile
# GROQ_MODEL_FAST=llama-3.1-8b-instant
# OPENROUTER_MODEL_SMART=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_MODEL_FAST=meta-llama/llama-3.1-8b-instruct

# Bare 10-digit phone numbers get this prefix for Twilio (E.164). Leave empty to require full +CC numbers.
DEFAULT_PHONE_COUNTRY_CODE=
